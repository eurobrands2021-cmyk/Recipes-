# Mock Mode is the default: the app runs entirely on the curated seed data in
# lib/recipes-data.ts with no database. Leave MOCK_MODE unset (or "true").
MOCK_MODE=true

# Canonical public origin, used for metadataBase so Open Graph / Twitter share
# images and canonical URLs are absolute (required by WhatsApp / Facebook /
# Twitter link-preview crawlers). Set this to your real deployed domain.
# On Vercel it falls back to the deployment URL automatically if unset.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# To use a live PostgreSQL database instead, set MOCK_MODE=false and provide a
# connection string, then run:
#   npm run prisma:generate && npm run prisma:migrate && npm run db:seed
# MOCK_MODE=false
# DATABASE_URL="postgresql://user:password@localhost:5432/tetas_cookbook?schema=public"
